{
  "name": "opendil",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source reference implementation, specification, and corpus for DIL (Dynamic Interface Language)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:update": "UPDATE_SNAPSHOTS=1 pnpm -r test",
    "bench": "pnpm --filter @kkkiio/dil-benchmarks run bench",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@kkkiio/dil-core": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
